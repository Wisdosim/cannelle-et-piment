// ============================================================================
// PRISMA SCHEMA (SQLITE) - CANNELLE ET PIMENT API
// Description: Version SQLite locale pour tests rapides de l'API
// ============================================================================

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Modèle Article (Fiche Ingredient)
model Article {
  id                  String             @id @default(uuid())
  nom                 String             @unique
  categorie           String             // Validée au niveau applicatif Express
  uniteAchat          String             @map("unite_achat")
  uniteRecette        String             @map("unite_recette")
  facteurConversion   Float              @default(1.0) @map("facteur_conversion")
  uniteBase           String             @map("unite_base") // ex: "Kg", "L"
  prixUnitaireBase    Float              @default(0.0) @map("prix_unitaire_base") // prix calculé au kg/L
  prixAchatUnitaire   Float              @default(0.0) @map("prix_achat_unitaire")
  
  // Suivi RSE (EGAlim) Optionnel
  familleRSE          String?            @map("famille_rse")
  classificationRSE   String?            @map("classification_rse")

  // Relations
  achats              AchatFacture[]
  ficheLignes         FicheTechniqueLigne[]
  
  creeLe              DateTime           @default(now()) @map("cree_le")
  misAJourLe          DateTime           @updatedAt @map("mis_a_jour_le")

  @@map("articles")
}


// Modèle EmployeOuProfil (Comptabilité analytique de la main d'œuvre)
model EmployeOuProfil {
  id                String   @id @default(uuid())
  nomOuType         String   @unique @map("nom_ou_type") // ex. "Jean Dupont" ou "Extra Commis"
  role              String   // Validé au niveau applicatif Express (COMMIS, SERVEUR, etc.)
  coutHoraireCharge Float    @map("cout_horaire_charge") // coût réel chargé pour l'entreprise
  
  tempsTravail      TempsTravailEvenement[]

  creeLe            DateTime @default(now()) @map("cree_le")
  misAJourLe        DateTime @updatedAt @map("mis_a_jour_le")

  @@map("employes_ou_profils")
}

// Modèle Facture (Facture fournisseur regroupant plusieurs lignes d'achats)
model Facture {
  id                  String         @id @default(uuid())
  numeroFacture       String?        @map("numero_facture")
  dateFacture         DateTime       @default(now()) @map("date_facture")
  fournisseur         String?
  creeLe              DateTime       @default(now()) @map("cree_le")

  // Relations
  lignes              AchatFacture[]

  @@map("factures")
}

// Modèle AchatFacture (Enregistrement d'achat facturé)
model AchatFacture {
  id                  String   @id @default(uuid())
  articleId           String   @map("article_id")
  prixTotalLigne      Float    @map("prix_total_ligne")
  quantiteAchetee     Float    @map("quantite_achetee")
  uniteAchat          String   @map("unite_achat")
  poidsReelUniteBase  Float    @map("poids_reel_unite_base") // ex. Poids total acheté en unité de base (Kg, L)
  creeLe              DateTime @default(now()) @map("cree_le")
  evenementDevisId    String?  @map("evenement_devis_id")
  achatSpecifique     Boolean  @default(false) @map("achat_specifique")

  factureId           String?        @map("facture_id")
  facture             Facture?       @relation(fields: [factureId], references: [id], onDelete: Cascade)

  // Relations
  article             Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  evenementDevis      EvenementDevis? @relation(fields: [evenementDevisId], references: [id], onDelete: SetNull)

  @@map("achats_factures")
}

// Modèle FicheTechnique (Recette de cuisine)
model FicheTechnique {
  id              String                @id @default(uuid())
  nomRecette      String                @unique @map("nom_recette")
  categoriePlat   String                @map("categorie_plat") // Validé au niveau applicatif Express (Entree, Plat, etc.)
  
  // Relations
  lignes             FicheTechniqueLigne[]
  devisLignesProduit DevisLigneProduit[]

  creeLe          DateTime              @default(now()) @map("cree_le")
  misAJourLe      DateTime              @updatedAt @map("mis_a_jour_le")

  @@map("fiches_techniques")
}

// Modèle FicheTechniqueLigne (Ingrédients nécessaires pour une recette)
model FicheTechniqueLigne {
  id                            String          @id @default(uuid())
  ficheTechniqueId              String          @map("fiche_technique_id")
  articleId                     String          @map("article_id")
  quantiteNecessaireUniteBase   Float           @map("quantite_necessaire_unite_base") // ex. 0.150 Kg

  // Relations
  ficheTechnique                FicheTechnique  @relation(fields: [ficheTechniqueId], references: [id], onDelete: Cascade)
  article                       Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("fiche_technique_lignes")
}

// Modèle EvenementDevis — Moteur de calcul de coût de revient
model EvenementDevis {
  id                        String                  @id @default(uuid())
  nomClient                 String                  @map("nom_client")
  dateEvenement             DateTime                @map("date_evenement")
  chiffreAffairesSaisi      Float                   @default(0.0) @map("chiffre_affaires_saisi") // CA saisi manuellement pour calculer la marge
  chiffreAffairesSaisiPrevu Float                   @default(0.0) @map("chiffre_affaires_saisi_prevu")
  chiffreAffairesSaisiReel  Float                   @default(0.0) @map("chiffre_affaires_saisi_reel")
  status                    String                  @default("Brouillon") // Valeurs : Brouillon, Envoye, Valide_Acompte, Termine

  // Comptabilité analytique
  tempsProductionEstimeHeures Float?              @map("temps_production_estime_heures") // Heures de production estimées pour imputation des charges fixes

  // Relations
  devisLots             DevisLot[]
  tempsTravail          TempsTravailEvenement[]
  fraisExternes         FraisExterne[]
  analyseRentabilite    AnalyseRentabilite?
  achatsFactures        AchatFacture[]

  creeLe                DateTime                @default(now()) @map("cree_le")
  misAJourLe            DateTime                @updatedAt @map("mis_a_jour_le")

  @@map("evenements_devis")
}

// Modèle DevisLot (ex: Cocktail, Dîner, Boissons)
model DevisLot {
  id                String              @id @default(uuid())
  evenementDevisId  String              @map("evenement_devis_id")
  nom               String

  // Relations
  evenementDevis    EvenementDevis      @relation(fields: [evenementDevisId], references: [id], onDelete: Cascade)
  prestations       DevisPrestation[]
  lignesProduit     DevisLigneProduit[]

  creeLe            DateTime            @default(now()) @map("cree_le")
  misAJourLe        DateTime            @updatedAt @map("mis_a_jour_le")

  @@map("devis_lots")
}

// Modèle DevisPrestation (ex: Atelier Plancha, Buffet Fromages)
model DevisPrestation {
  id            String              @id @default(uuid())
  devisLotId    String              @map("devis_lot_id")
  nom           String

  // Relations
  devisLot      DevisLot            @relation(fields: [devisLotId], references: [id], onDelete: Cascade)
  lignesProduit DevisLigneProduit[]

  creeLe        DateTime            @default(now()) @map("cree_le")
  misAJourLe    DateTime            @updatedAt @map("mis_a_jour_le")

  @@map("devis_prestations")
}

// Modèle DevisLigneProduit (ex: Risotto de Saint-Jacques au Safran)
model DevisLigneProduit {
  id                  String           @id @default(uuid())
  devisLotId          String           @map("devis_lot_id")
  devisPrestationId   String?          @map("devis_prestation_id")
  ficheTechniqueId    String           @map("fiche_technique_id")
  quantitePrevue      Int              @map("quantite_prevue")
  prixUnitaireFige    Float            @default(0.0) @map("prix_unitaire_fige")

  // Relations
  devisLot            DevisLot         @relation(fields: [devisLotId], references: [id], onDelete: Cascade)
  devisPrestation     DevisPrestation? @relation(fields: [devisPrestationId], references: [id], onDelete: Cascade)
  ficheTechnique      FicheTechnique   @relation(fields: [ficheTechniqueId], references: [id], onDelete: Cascade)

  creeLe              DateTime         @default(now()) @map("cree_le")
  misAJourLe          DateTime         @updatedAt @map("mis_a_jour_le")

  @@map("devis_lignes_produit")
}

// Modèle TempsTravailEvenement (Main d'œuvre directe affectée à un événement)
model TempsTravailEvenement {
  id                      String          @id @default(uuid())
  evenementDevisId        String          @map("evenement_devis_id")
  employeId               String          @map("employe_id")
  totalHeuresPrepareesEtJourJ Float       @default(0.0) @map("total_heures_preparees_et_jour_j")
  prixUnitaireFige        Float           @default(0.0) @map("prix_unitaire_fige")
  coutTotalMainOeuvre     Float           @map("cout_total_main_oeuvre") // calculé automatiquement

  // Relations
  evenementDevis          EvenementDevis  @relation(fields: [evenementDevisId], references: [id], onDelete: Cascade)
  employe                 EmployeOuProfil @relation(fields: [employeId], references: [id], onDelete: Cascade)

  creeLe                  DateTime        @default(now()) @map("cree_le")
  misAJourLe              DateTime        @updatedAt @map("mis_a_jour_le")

  @@map("temps_travail_evenements")
}

// Modèle FraisExterne (Frais directs logistiques, etc.)
model FraisExterne {
  id                      String          @id @default(uuid())
  evenementDevisId        String          @map("evenement_devis_id")
  categorie               String          // ex: Location vaisselle
  montantHT               Float           @map("montant_ht")

  // Relations
  evenementDevis          EvenementDevis  @relation(fields: [evenementDevisId], references: [id], onDelete: Cascade)

  creeLe                  DateTime        @default(now()) @map("cree_le")
  misAJourLe              DateTime        @updatedAt @map("mis_a_jour_le")

  @@map("frais_externes")
}

// Modèle AnalyseRentabilite (Consolidation analytique — moteur coût de revient)
model AnalyseRentabilite {
  id                      String          @id @default(uuid())
  evenementDevisId        String          @unique @map("evenement_devis_id")
  totalCoutMatiere        Float           @map("total_cout_matiere")
  totalMainOeuvreDirecte  Float           @map("total_main_oeuvre_directe")
  totalFraisExternes      Float           @map("total_frais_externes")
  margeBruteHT            Float           @map("marge_brute_ht")             // CA Saisi - Coûts directs totaux
  quotePartFraisFixes     Float           @default(0.0) @map("quote_part_frais_fixes")
  tauxPerteForfaitaire    Float           @default(5.0) @map("taux_perte_forfaitaire") // Taux global par défaut
  tauxPerteSaisi          Float?          @map("taux_perte_saisi")            // Taux saisi manuellement pour cet événement (prioritaire)
  coutPerteAlimentaire    Float           @default(0.0) @map("cout_perte_alimentaire")
  margeNetteHT            Float           @default(0.0) @map("marge_nette_ht")
  coutRevientParConvive   Float           @default(0.0) @map("cout_revient_par_convive")

  // Nouveaux champs prévus et réels
  coutMatierePrevu        Float           @default(0.0) @map("cout_matiere_prevu")
  coutMatiereReel         Float           @default(0.0) @map("cout_matiere_reel")
  coutMainOeuvrePrevu     Float           @default(0.0) @map("cout_main_oeuvre_prevu")
  coutMainOeuvreReel      Float           @default(0.0) @map("cout_main_oeuvre_reel")

  // Relations
  evenementDevis          EvenementDevis  @relation(fields: [evenementDevisId], references: [id], onDelete: Cascade)

  creeLe                  DateTime        @default(now()) @map("cree_le")
  misAJourLe              DateTime        @updatedAt @map("mis_a_jour_le")

  @@map("analyses_rentabilite")
}



// Modèle ConfigurationGlobale (Table à ligne unique pour les paramètres généraux)
model ConfigurationGlobale {
  id                                  String   @id @default("single-config-row")
  quotePartChargesTraiteurPourcentage Float    @default(80.0) @map("quote_part_charges_traiteur_pourcentage")
  tauxPerteForfaitaireDefaut          Float    @default(0.0) @map("taux_perte_forfaitaire_defaut")

  creeLe                              DateTime @default(now()) @map("cree_le")
  misAJourLe                          DateTime @updatedAt @map("mis_a_jour_le")

  @@map("configuration_globale")
}

// Modèle ParametresFinanciers (Charges fixes de l'entreprise — singleton)
model ParametresFinanciers {
  id                        String   @id @default("single-financials-row")

  // Charges fixes annuelles (€)
  loyerAnnuel               Float    @default(0.0) @map("loyer_annuel")
  electriciteAnnuelle       Float    @default(0.0) @map("electricite_annuelle")
  assurancesAnnuelles       Float    @default(0.0) @map("assurances_annuelles")
  masseSalarialeIndirecte   Float    @default(0.0) @map("masse_salariale_indirecte") // charges patronales indirectes, gérance, etc.
  autresChargesAnnuelles    Float    @default(0.0) @map("autres_charges_annuelles")

  // Capacité de production
  joursOuvertureAn          Float    @default(220.0) @map("jours_ouverture_an")  // Jours travaillés par an
  heuresParJour             Float    @default(8.0)   @map("heures_par_jour")    // Heures de production par jour

  creeLe                    DateTime @default(now()) @map("cree_le")
  misAJourLe                DateTime @updatedAt @map("mis_a_jour_le")

  @@map("parametres_financiers")
}
